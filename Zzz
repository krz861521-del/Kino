local Save = {
    cfg = { Cooldown = 2.4, MinSpeed = 18, Range = 75 },
    conn = nil, charConn = nil, diveConn = nil, bv = nil,
    humanoid = nil, rootPart = nil,
    DiveRemote = nil, StaminaRemote = nil, MovementAnims = nil,
    animTracks = {}, lastDive = 0,
    diving = false, ready = false, enabled = false,
}

local GOAL_WIDTH = 48
local GOAL_HEIGHT = 29
local DIVE_SPEED = 65.2
local DECEL_VAL = 37
local GROUND_VERTICAL = 35
local GROUND_GRAVITY = 130
local AIR_DIVE_MIN = 75
local AIR_DIVE_MAX = 85
local AIR_GRAVITY = 300
local NUDGE_DURATION = 0.55
local REL_VEL_Z_MIN = 1.5

local function getBall()
    local f = workspace:FindFirstChild("Football")
    if f then
        local part = f:FindFirstChild("Hitbox") or f:FindFirstChild("BALL") or f:FindFirstChildWhichIsA("BasePart")
        if part then return part end
        if f:IsA("BasePart") then return f end
    end
    return nil
end

local function saveSetup()
    local char = LP.Character or LP.CharacterAdded:Wait()
    Save.humanoid = char:WaitForChild("Humanoid")
    Save.rootPart = char:WaitForChild("HumanoidRootPart")

    local ok, err = pcall(function()
        local services = ReplicatedStorage:WaitForChild("Packages", 5):WaitForChild("Knit", 5):WaitForChild("Services", 5)
        Save.DiveRemote = services:WaitForChild("BallService", 5):WaitForChild("RE", 5):WaitForChild("Dive", 5)
        Save.StaminaRemote = services:WaitForChild("StaminaService", 5):WaitForChild("RE", 5):WaitForChild("DecreaseStamina", 5)
        Save.MovementAnims = ReplicatedStorage:WaitForChild("Assets", 5):WaitForChild("ReplicatedAnims", 5):WaitForChild("Movement", 5)
    end)
    if not ok then return false, err end

    Save.animTracks = {}
    for _, name in ipairs({ "DiveL", "DiveR", "DiveF" }) do
        local anim = Save.MovementAnims:FindFirstChild(name)
        if anim then
            Save.animTracks[name] = Save.humanoid:LoadAnimation(anim)
        end
    end
    return true
end

local function isBallHeadingIntoGoal(ball)
    local rootPart = Save.rootPart
    if not rootPart then return false end
    local vel = ball.AssemblyLinearVelocity
    if vel.Magnitude < Save.cfg.MinSpeed then return false end

    local relVel = rootPart.CFrame:VectorToObjectSpace(vel)
    local relPos = rootPart.CFrame:PointToObjectSpace(ball.Position)

    if relVel.Z <= REL_VEL_Z_MIN then return false end

    local timeToGoal = math.abs(relPos.Z / relVel.Z)
    if timeToGoal > 3.5 then return false end

    local predictedX = relPos.X + (relVel.X * timeToGoal)
    local predictedY = ball.Position.Y + (vel.Y * timeToGoal) + (0.5 * -workspace.Gravity * timeToGoal ^ 2)

    return math.abs(predictedX) < (GOAL_WIDTH / 2)
        and predictedY > 0
        and predictedY < GOAL_HEIGHT
end

local function performDive(ball)
    local rootPart, humanoid = Save.rootPart, Save.humanoid
    if Save.diving or not rootPart or not humanoid or not Save.DiveRemote then return end
    local now = tick()
    if now - Save.lastDive < Save.cfg.Cooldown then return end

    Save.diving = true
    Save.lastDive = now

    local vel = ball.AssemblyLinearVelocity
    local relVel = rootPart.CFrame:VectorToObjectSpace(vel)
    local relPos = rootPart.CFrame:PointToObjectSpace(ball.Position)

    local pTime = math.clamp(math.abs(relPos.Z / math.max(math.abs(relVel.Z), 0.5)), 0.01, 1.5)
    local targetPos = ball.Position + (vel * pTime) + (0.5 * Vector3.new(0, -workspace.Gravity, 0) * pTime ^ 2)

    local currentRelY = ball.Position.Y - rootPart.Position.Y
    local predictedRelY = targetPos.Y - rootPart.Position.Y
    local isAirShot = (predictedRelY > 4) or (currentRelY > 4)

    local rel = rootPart.CFrame:PointToObjectSpace(targetPos)
    local animName, dirKey, velX
    if rel.X > 0 then
        animName, dirKey, velX = "DiveR", "r", DIVE_SPEED
    else
        animName, dirKey, velX = "DiveL", "l", -DIVE_SPEED
    end

    local diveVertical = isAirShot
        and math.clamp(AIR_DIVE_MIN + (math.max(currentRelY, predictedRelY) * 2.5), AIR_DIVE_MIN, AIR_DIVE_MAX)
        or GROUND_VERTICAL
    local currentGravity = isAirShot and AIR_GRAVITY or GROUND_GRAVITY

    pcall(function() Save.StaminaRemote:FireServer(10) end)
    pcall(function() Save.DiveRemote:FireServer(targetPos, pTime, dirKey) end)

    local track = Save.animTracks[animName]
    if track then
        track.Priority = Enum.AnimationPriority.Action4
        track:Play(0, 1, 1.4)
    end

    humanoid:ChangeState(Enum.HumanoidStateType.Physics)
    pcall(function() rootPart:SetNetworkOwner(LP) end)

    if Save.diveConn then Save.diveConn:Disconnect() Save.diveConn = nil end
    if Save.bv then pcall(function() Save.bv:Destroy() end) end

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1, 1, 1) * 2500000
    bv.Parent = rootPart
    Save.bv = bv

    local initialWorldMove = rootPart.CFrame:VectorToWorldSpace(Vector3.new(velX, 0, 0))
    rootPart.AssemblyLinearVelocity = initialWorldMove + Vector3.new(0, diveVertical, 0)

    local startTime = tick()
    local currentVelX = velX
    local currentVelV = diveVertical

    Save.diveConn = RunService.Heartbeat:Connect(function(dt)
        if not rootPart or not bv or not bv.Parent then
            if Save.diveConn then Save.diveConn:Disconnect() Save.diveConn = nil end
            Save.diving = false
            return
        end

        local elapsed = tick() - startTime
        if elapsed > NUDGE_DURATION then
            bv:Destroy()
            Save.bv = nil
            local v = rootPart.AssemblyLinearVelocity
            rootPart.AssemblyLinearVelocity = Vector3.new(v.X * 0.25, math.min(v.Y, -14), v.Z * 0.25)
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
            if Save.diveConn then Save.diveConn:Disconnect() Save.diveConn = nil end
            Save.diving = false
            return
        end

        local worldMove = rootPart.CFrame:VectorToWorldSpace(Vector3.new(currentVelX, 0, 0))
        bv.Velocity = worldMove + Vector3.new(0, currentVelV, 0)

        if elapsed > 0.08 then
            currentVelX = currentVelX - (dt * (currentVelX > 0 and DECEL_VAL or -DECEL_VAL))
        end
        currentVelV = currentVelV - (dt * currentGravity)
    end)
end

local function saveStep()
    local rootPart = Save.rootPart
    if not Save.ready or Save.diving or not rootPart or not rootPart.Parent then return end

    local ball = getBall()
    if not ball then return end

    if (ball.Position - rootPart.Position).Magnitude > Save.cfg.Range then return end

    if isBallHeadingIntoGoal(ball) then
        performDive(ball)
    end
end

function Save.enable(fail)
    Save.enabled = true
    Save.ready = false

    task.spawn(function()
        local ok, err = saveSetup()
        if not Save.enabled then return end
        if not ok then
            warn("[BlueHub] Auto Save:", err)
            if fail then fail("Auto Save: no encontré los remotes del juego") end
            return
        end
        Save.ready = true
    end)

    Save.charConn = LP.CharacterAdded:Connect(function()
        Save.ready = false
        task.wait(0.5)
        if not Save.enabled then return end
        local ok = saveSetup()
        Save.ready = ok and Save.enabled
    end)

    Save.conn = RunService.Heartbeat:Connect(saveStep)
end

function Save.disable()
    Save.enabled = false
    Save.ready = false
    if Save.conn then Save.conn:Disconnect() Save.conn = nil end
    if Save.charConn then Save.charConn:Disconnect() Save.charConn = nil end
    if Save.diveConn then Save.diveConn:Disconnect() Save.diveConn = nil end
    if Save.bv then
        pcall(function() Save.bv:Destroy() end)
        Save.bv = nil
        pcall(function() Save.humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    end
    Save.diving = false
end

