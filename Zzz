local Stamina = { conn = nil, charConn = nil, on = false }

local function staminaHook(fail)
    local stats = LP:FindFirstChild("PlayerStats") or LP:WaitForChild("PlayerStats", 10)
    local stam = stats and (stats:FindFirstChild("Stamina") or stats:WaitForChild("Stamina", 5))
    if not stam then
        if fail then fail("Stamina: no encontré PlayerStats") end
        return
    end
    if not Stamina.on then return end

    if Stamina.conn then Stamina.conn:Disconnect() end
    stam.Value = 100
    Stamina.conn = stam:GetPropertyChangedSignal("Value"):Connect(function()
        if stam.Value < 95 then stam.Value = 100 end
    end)
end

function Stamina.enable(fail)
    Stamina.on = true
    task.spawn(staminaHook, fail)
    Stamina.charConn = LP.CharacterAdded:Connect(function()
        task.wait(1.5)
        if Stamina.on then staminaHook() end
    end)
end

function Stamina.disable()
    Stamina.on = false
    if Stamina.conn then Stamina.conn:Disconnect() Stamina.conn = nil end
    if Stamina.charConn then Stamina.charConn:Disconnect() Stamina.charConn = nil end
end

