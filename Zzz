local Dribble = {
    cfg = {
        TriggerName = "Sliding",
        DribbleName = "Dribbling",
        Range = 15,
        FacingDot = 0.5,
        Cooldown = 0.8,
        ReactionDelay = 0.05,
        DribbleKey = Enum.KeyCode.Q,
        RemoteArgs = {},
        IgnoreTeammates = true,
    },
    conn = nil, active = {}, last = 0, remote = nil, button = nil,
}

local function dFindRemote()
    if Dribble.remote and Dribble.remote.Parent then return Dribble.remote end
    for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
        if (d:IsA("RemoteEvent") or d:IsA("RemoteFunction")) and d.Name == Dribble.cfg.DribbleName then
            Dribble.remote = d
            return d
        end
    end
end

local function dFindButton()
    if Dribble.button and Dribble.button.Parent then return Dribble.button end
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return end
    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("GuiButton") and d.Name == Dribble.cfg.DribbleName then
            Dribble.button = d
            return d
        end
    end
end

local function dPress(btn)
    if not getconnections then return false end
    local fired = false
    for _, sig in ipairs({ btn.MouseButton1Down, btn.MouseButton1Click, btn.MouseButton1Up, btn.Activated, btn.TouchTap }) do
        pcall(function()
            for _, c in ipairs(getconnections(sig)) do
                c:Fire()
                fired = true
            end
        end)
    end
    return fired
end

local function dDribble()
    local cfg = Dribble.cfg
    local remote = dFindRemote()
    if remote then
        local ok = pcall(function()
            if remote:IsA("RemoteEvent") then
                remote:FireServer(table.unpack(cfg.RemoteArgs))
            else
                remote:InvokeServer(table.unpack(cfg.RemoteArgs))
            end
        end)
        if ok then return end
    end

    local btn = dFindButton()
    if btn and dPress(btn) then return end

    local ok, vim = pcall(function() return game:GetService("VirtualInputManager") end)
    if ok and vim then
        vim:SendKeyEvent(true, cfg.DribbleKey, false, game)
        task.delay(0.05, function()
            vim:SendKeyEvent(false, cfg.DribbleKey, false, game)
        end)
    end
end

local function dTrigger()
    if os.clock() - Dribble.last < Dribble.cfg.Cooldown then return end
    Dribble.last = os.clock()
    task.delay(Dribble.cfg.ReactionDelay, dDribble)
end

local function dIsTrigger(track)
    local a = track.Animation
    local wanted = string.lower(Dribble.cfg.TriggerName)
    for _, n in ipairs({ track.Name, a and a.Name or "" }) do
        if n ~= "" and string.find(string.lower(n), wanted, 1, true) then
            return true
        end
    end
    return false
end

local function dFacing(root, toMe)
    local flat = Vector3.new(toMe.X, 0, toMe.Z)
    if flat.Magnitude < 0.05 then return true end
    local look = root.CFrame.LookVector
    look = Vector3.new(look.X, 0, look.Z)
    if look.Magnitude < 0.05 then return false end
    return look.Unit:Dot(flat.Unit) >= Dribble.cfg.FacingDot
end

local function dStep()
    local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local cfg = Dribble.cfg
    local nowActive = {}

    for _, player in ipairs(Players:GetPlayers()) do
        local sameTeam = cfg.IgnoreTeammates and player.Team and player.Team == LP.Team
        if player ~= LP and not sameTeam then
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local animator = hum and hum:FindFirstChildOfClass("Animator")

            if root and animator then
                local toMe = myRoot.Position - root.Position
                if toMe.Magnitude <= cfg.Range then
                    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                        if dIsTrigger(track) then
                            nowActive[track] = true
                            if not Dribble.active[track] and dFacing(root, toMe) then
                                dTrigger()
                            end
                        end
                    end
                end
            end
        end
    end

    Dribble.active = nowActive
end

function Dribble.enable()
    Dribble.active = {}
    Dribble.conn = RunService.Heartbeat:Connect(dStep)
end

function Dribble.disable()
    if Dribble.conn then Dribble.conn:Disconnect() Dribble.conn = nil end
    Dribble.active = {}
end

