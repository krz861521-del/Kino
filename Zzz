local GOAL_WIDTH = 48
local DECEL_VAL = 37
local GROUND_VERTICAL, GROUND_GRAVITY = 35, 130
local AIR_DIVE_MIN, AIR_DIVE_MAX, AIR_GRAVITY = 75, 85, 300
local NUDGE_DURATION, REL_VEL_Z_MIN, BEHIND_TOL = 0.55, 1.5, 2

