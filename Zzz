-- AutoShot v7
-- Tú pateas normal (con animación) y el tiro se desvía a un punto
-- aleatorio de la portería. ON/OFF con el botón o con la tecla K.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Debris = game:GetService("Debris")
local LocalPlayer = Players.LocalPlayer

if getgenv and getgenv().AutoShot then
    pcall(function() getgenv().AutoShot.stop() end)
end

local Config = {
    Enabled        = true,
    Mode           = "Both",  -- "Aim": gira personaje+cámara hacia el punto antes de que salga el tiro
                              -- "Redirect": desvía la pelota después del tiro (solo si la controlas tú)
                              -- "Both": las dos cosas (recomendado)
    GoalRange      = 70,      -- distancia máx a la portería (studs)
    MinGoalRange   = 3,
    BallRange      = 14,      -- la pelota debe estar cerca de ti
    RequireBall    = true,
    FacingDot      = -1,      -- -1 = patees hacia donde patees | 0 = portería al frente | 0.5 = estricto
    HorizMargin    = 0.12,    -- evita los postes
    HeightMin      = 0.15,    -- solo Redirect: altura mínima (0 piso, 1 travesaño)
    HeightMax      = 0.85,
    AimDelay       = 0.12,    -- espera para que el servidor reciba tu nueva orientación
    AlsoTurnCamera = true,    -- gira también la cámara (muchos juegos orientan al personaje con la cámara)
    PowerOverride  = false,   -- poner 110 para forzar potencia máxima
    RedirectDelay  = 0.05,
    CompensateGravity = true,
    DefaultGoalWidth = 24,    -- si no se puede medir la portería
    MaxGoalWidth   = 45,
    ToggleKey      = Enum.KeyCode.K,
    ShowButton     = true,
    ShowMarker     = false,   -- punto rojo donde apunta (para probar)
    Debug          = true,
}

local running = true
local conns = {}
local bypass = false
local shotsSeen = 0
local hookInstalled = false
local gui

local function log(...)
    if Config.Debug then print("[AutoShot]", ...) end
end

-- ========== REMOTE ==========

local ShootRemote

local function resolveRemote()
    local ok, re = pcall(function()
        return ReplicatedStorage.Packages.Knit.Services.BallService.RE
    end)
    if ok and re then ShootRemote = re:FindFirstChild("Shoot") end
    if not ShootRemote then
        for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
            if d:IsA("RemoteEvent") and d.Name == "Shoot" then
                ShootRemote = d
                break
            end
        end
    end
end
resolveRemote()

local function isShoot(inst)
    if inst == ShootRemote then return true end
    return typeof(inst) == "Instance" and inst.ClassName == "RemoteEvent" and inst.Name == "Shoot"
end

-- ========== PORTERÍAS (con tamaño) ==========

local KEYWORDS = { "goal", "net", "post", "arco", "porter" }
local goals = {}
local manualGoals = false
local scanTries = 0
local ownGoal

local function nameMatches(name)
    name = name:lower()
    for _, k in ipairs(KEYWORDS) do
        if name:find(k, 1, true) then return true end
    end
    return false
end

local function extend(c, part)
    local cf, s = part.CFrame, part.Size / 2
    for _, sx in ipairs({ -1, 1 }) do
        for _, sy in ipairs({ -1, 1 }) do
            for _, sz in ipairs({ -1, 1 }) do
                local p = cf:PointToWorldSpace(Vector3.new(sx * s.X, sy * s.Y, sz * s.Z))
                c.min = Vector3.new(math.min(c.min.X, p.X), math.min(c.min.Y, p.Y), math.min(c.min.Z, p.Z))
                c.max = Vector3.new(math.max(c.max.X, p.X), math.max(c.max.Y, p.Y), math.max(c.max.Z, p.Z))
            end
        end
    end
end

local function buildGoal(c)
    local size = c.max - c.min
    local alongX = size.X >= size.Z
    local width = alongX and size.X or size.Z
    local height = size.Y
    if width < 4 or width > Config.MaxGoalWidth then width = Config.DefaultGoalWidth end
    if height < 2 or height > 25 then height = 8 end
    return { center = (c.max + c.min) / 2, alongX = alongX, width = width, height = height }
end

local function scanGoals()
    scanTries += 1
    local parts = {}
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("BasePart") and nameMatches(d.Name) then
            local y = d.Position.Y
            if y < 100 and y > -50 then
                local model = d:FindFirstAncestorOfClass("Model")
                if not (model and Players:GetPlayerFromCharacter(model)) then
                    table.insert(parts, d)
                end
            end
        end
    end

    local clusters = {}
    for _, part in ipairs(parts) do
        local pos = part.Position
        local target
        for _, c in ipairs(clusters) do
            if (c.sum / c.n - pos).Magnitude < 30 then
                target = c
                break
            end
        end
        if not target then
            target = {
                sum = Vector3.new(0, 0, 0), n = 0,
                min = Vector3.new(math.huge, math.huge, math.huge),
                max = Vector3.new(-math.huge, -math.huge, -math.huge),
            }
            table.insert(clusters, target)
        end
        target.sum += pos
        target.n += 1
        extend(target, part)
    end

    goals = {}
    if #clusters == 1 then
        goals = { buildGoal(clusters[1]) }
    elseif #clusters >= 2 then
        local a, b, best = nil, nil, 0
        for i = 1, #clusters do
            for j = i + 1, #clusters do
                local d = (clusters[i].sum / clusters[i].n - clusters[j].sum / clusters[j].n).Magnitude
                if d > best then best, a, b = d, clusters[i], clusters[j] end
            end
        end
        goals = { buildGoal(a), buildGoal(b) }
    end
    log("Porterías:", #goals, "| partes candidatas:", #parts)
end

task.spawn(function()
    while running and not manualGoals and #goals < 2 and scanTries < 6 do
        scanGoals()
        task.wait(5)
    end
end)

local function isOwn(g)
    return ownGoal ~= nil and (g.center - ownGoal).Magnitude < 25
end

-- elige la portería que más estás mirando (dentro del rango)
local function pickGoal(myRoot)
    local best, bestDot, bestDist
    local look = myRoot.CFrame.LookVector
    look = Vector3.new(look.X, 0, look.Z)
    for _, g in ipairs(goals) do
        if not isOwn(g) then
            local to = g.center - myRoot.Position
            local dist = to.Magnitude
            if dist >= Config.MinGoalRange and dist <= Config.GoalRange then
                local flat = Vector3.new(to.X, 0, to.Z)
                local dot = 1
                if look.Magnitude > 0.05 and flat.Magnitude > 0.05 then
                    dot = look.Unit:Dot(flat.Unit)
                end
                if dot >= Config.FacingDot and (not bestDot or dot > bestDot) then
                    best, bestDot, bestDist = g, dot, dist
                end
            end
        end
    end
    return best, bestDist
end

local function randomPoint(g)
    local t = Config.HorizMargin + math.random() * (1 - 2 * Config.HorizMargin)
    local off = (t - 0.5) * g.width
    local x, z = g.center.X, g.center.Z
    if g.alongX then x += off else z += off end
    local base = g.center.Y - g.height / 2
    local hf = Config.HeightMin + math.random() * (Config.HeightMax - Config.HeightMin)
    return Vector3.new(x, base + g.height * hf, z)
end

local function marker(pos)
    local p = Instance.new("Part")
    p.Shape = Enum.PartType.Ball
    p.Size = Vector3.new(1.5, 1.5, 1.5)
    p.Material = Enum.Material.Neon
    p.Color = Color3.fromRGB(255, 60, 60)
    p.Anchored = true
    p.CanCollide = false
    p.CanQuery = false
    p.Position = pos
    p.Parent = workspace
    Debris:AddItem(p, 2.5)
end

-- ========== PELOTA ==========

local ballCache
local function getBall()
    if ballCache and ballCache.Parent then return ballCache end
    local f = workspace:FindFirstChild("Football")
        or workspace:FindFirstChild("Ball")
        or workspace:FindFirstChild("Football", true)
    local part
    if f then
        if f:IsA("BasePart") then
            part = f
        else
            part = f:FindFirstChild("Hitbox")
                or f:FindFirstChild("BALL")
                or (f:IsA("Model") and f.PrimaryPart)
                or f:FindFirstChildWhichIsA("BasePart", true)
        end
    end
    ballCache = part
    return part
end

-- ========== APUNTAR (personaje + cámara bloqueados mientras sale el tiro) ==========

local AIM_BIND = "AutoShotAim"

local function lockAim(hum, myRoot, target, duration)
    pcall(function() RunService:UnbindFromRenderStep(AIM_BIND) end)
    local cam = workspace.CurrentCamera
    local endAt = os.clock() + duration
    local prevAuto = hum.AutoRotate
    hum.AutoRotate = false

    RunService:BindToRenderStep(AIM_BIND, Enum.RenderPriority.Camera.Value + 1, function()
        if os.clock() > endAt or not myRoot.Parent then
            pcall(function() RunService:UnbindFromRenderStep(AIM_BIND) end)
            pcall(function() hum.AutoRotate = prevAuto end)
            return
        end
        local p = myRoot.Position
        myRoot.CFrame = CFrame.lookAt(p, Vector3.new(target.X, p.Y, target.Z))
        if Config.AlsoTurnCamera and cam then
            cam.CFrame = CFrame.lookAt(cam.CFrame.Position, target)
        end
    end)
end

-- ========== DESVIAR LA PELOTA (modo Redirect) ==========

local function redirectBall(target, extraDelay)
    task.wait(extraDelay + Config.RedirectDelay)
    local ball = getBall()
    if not ball then return end

    if isnetworkowner then
        local ok, owned = pcall(isnetworkowner, ball)
        if ok and not owned then
            log("La pelota la controla el servidor: no se puede desviar desde aquí")
            return
        end
    end

    local speed = ball.AssemblyLinearVelocity.Magnitude
    if speed < 5 then speed = 90 end
    local dir = target - ball.Position
    local t = math.max(dir.Magnitude / speed, 0.05)
    local vel = dir / t
    if Config.CompensateGravity then
        vel += Vector3.new(0, workspace.Gravity * t / 2, 0)
    end
    ball.AssemblyLinearVelocity = vel
    log("Pelota desviada, velocidad:", math.floor(vel.Magnitude))
end

-- ========== INTERCEPTAR TU TIRO ==========

-- devuelve "block" (cancela el tiro original y lo reenvía apuntado),
-- "pass" (deja pasar con argumentos modificados) o nil (no tocar nada)
local function handleShot(remote, args)
    log("Tiro detectado, argumentos:", args.n, args[1])

    local char = LocalPlayer.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not myRoot or not hum or hum.Health <= 0 then
        log("→ sin personaje")
        return nil
    end

    if Config.RequireBall then
        local ball = getBall()
        if not ball then
            log("→ no encuentro la pelota (workspace.Football)")
            return nil
        end
        local d = (ball.Position - myRoot.Position).Magnitude
        if d > Config.BallRange then
            log(("→ pelota lejos: %.1f studs (máx %d)"):format(d, Config.BallRange))
            return nil
        end
    end

    local goal, dist = pickGoal(myRoot)
    if not goal then
        log("→ ninguna portería en rango (porterías encontradas: " .. #goals .. ")")
        return nil
    end

    local target = randomPoint(goal)
    if Config.ShowMarker then marker(target) end
    if Config.PowerOverride then args[1] = Config.PowerOverride end
    log(("→ desviando a punto aleatorio (%.0f studs) modo %s"):format(dist, Config.Mode))

    local doAim = Config.Mode == "Aim" or Config.Mode == "Both"
    local doRedirect = Config.Mode == "Redirect" or Config.Mode == "Both"

    if doRedirect then
        task.spawn(redirectBall, target, doAim and Config.AimDelay or 0)
    end

    if doAim then
        lockAim(hum, myRoot, target, Config.AimDelay + 0.3)
        task.spawn(function()
            task.wait(Config.AimDelay)
            bypass = true
            pcall(function() remote:FireServer(table.unpack(args, 1, args.n)) end)
            bypass = false
        end)
        return "block"
    end

    return Config.PowerOverride and "pass" or nil
end

if not hookmetamethod or not getnamecallmethod then
    warn("[AutoShot] Tu executor no soporta hookmetamethod: no puedo detectar tu tiro.")
else
    local old
    old = hookmetamethod(game, "__namecall", (newcclosure or function(f) return f end)(function(self, ...)
        local method = getnamecallmethod()
        if method == "FireServer" and running and not bypass and isShoot(self) then
            shotsSeen += 1
            if Config.Enabled then
                local args = table.pack(...)
                local ok, action = pcall(handleShot, self, args)
                if setnamecallmethod then setnamecallmethod(method) end
                if ok then
                    if action == "block" then return end
                    if action == "pass" then return old(self, table.unpack(args, 1, args.n)) end
                else
                    warn("[AutoShot] error:", action)
                end
            end
        end
        return old(self, ...)
    end))
    hookInstalled = true
end

-- ========== BOTÓN ==========

local ON_COLOR = Color3.fromRGB(46, 204, 113)
local OFF_COLOR = Color3.fromRGB(231, 76, 60)
local render

local function setEnabled(v)
    Config.Enabled = v
    if render then render() end
end

local function guiParent()
    if gethui then
        local ok, h = pcall(gethui)
        if ok and h then return h end
    end
    local ok = pcall(function() return game:GetService("CoreGui"):GetChildren() end)
    if ok then return game:GetService("CoreGui") end
    return LocalPlayer:WaitForChild("PlayerGui")
end

if Config.ShowButton then
    gui = Instance.new("ScreenGui")
    gui.Name = "AutoShotGui"
    gui.ResetOnSpawn = false

    local card = Instance.new("Frame")
    card.Size = UDim2.fromOffset(170, 48)
    card.Position = UDim2.new(0, 12, 0.5, -24)
    card.BackgroundColor3 = Color3.fromRGB(24, 24, 32)
    card.BorderSizePixel = 0
    card.Active = true
    card.Parent = gui
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 24)

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 2
    stroke.Color = ON_COLOR
    stroke.Parent = card

    local title = Instance.new("TextLabel")
    title.BackgroundTransparency = 1
    title.Position = UDim2.fromOffset(16, 6)
    title.Size = UDim2.fromOffset(96, 20)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 15
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.TextColor3 = Color3.new(1, 1, 1)
    title.Text = "⚽ AutoShot"
    title.Parent = card

    local status = Instance.new("TextLabel")
    status.BackgroundTransparency = 1
    status.Position = UDim2.fromOffset(16, 25)
    status.Size = UDim2.fromOffset(96, 16)
    status.Font = Enum.Font.GothamMedium
    status.TextSize = 11
    status.TextXAlignment = Enum.TextXAlignment.Left
    status.Parent = card

    local track = Instance.new("Frame")
    track.Size = UDim2.fromOffset(44, 24)
    track.Position = UDim2.new(1, -58, 0.5, -12)
    track.BorderSizePixel = 0
    track.Parent = card
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(18, 18)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.BorderSizePixel = 0
    knob.Parent = track
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    render = function()
        local on = Config.Enabled
        local col = on and ON_COLOR or OFF_COLOR
        local info = TweenInfo.new(0.18, Enum.EasingStyle.Quad)
        TweenService:Create(track, info, { BackgroundColor3 = col }):Play()
        TweenService:Create(stroke, info, { Color = col }):Play()
        TweenService:Create(knob, info, { Position = on and UDim2.fromOffset(23, 3) or UDim2.fromOffset(3, 3) }):Play()
        status.Text = on and "ACTIVO" or "APAGADO"
        status.TextColor3 = col
    end
    knob.Position = UDim2.fromOffset(23, 3)
    render()

    -- tocar = ON/OFF, arrastrar = mover
    local dragging, moved, dragStart, startPos = false, false, nil, nil
    card.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, moved = true, false
            dragStart, startPos = input.Position, card.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if not moved then setEnabled(not Config.Enabled) end
                end
            end)
        end
    end)
    table.insert(conns, UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            if d.Magnitude > 8 then moved = true end
            if moved then
                card.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end
    end))

    gui.Parent = guiParent()
end

table.insert(conns, UserInputService.InputBegan:Connect(function(input, processed)
    if not processed and input.KeyCode == Config.ToggleKey then
        setEnabled(not Config.Enabled)
    end
end))

-- ========== API ==========

local api = {}

function api.stop()
    running = false
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    table.clear(conns)
    pcall(function() RunService:UnbindFromRenderStep(AIM_BIND) end)
    if gui then pcall(function() gui:Destroy() end) end
    if getgenv then getgenv().AutoShot = nil end
    print("[AutoShot] detenido")
end

function api.toggle() setEnabled(not Config.Enabled) end
function api.config() return Config end

function api.diagGoals()
    manualGoals = false
    scanGoals()
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    for i, g in ipairs(goals) do
        local d = myRoot and (g.center - myRoot.Position).Magnitude or 0
        print(("  Portería %d @ %s | ancho %.1f alto %.1f | %.1f studs"):format(
            i, tostring(g.center), g.width, g.height, d))
    end
end

-- punto rojo en la portería, sin disparar
function api.preview()
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local g = pickGoal(myRoot)
    if g then marker(randomPoint(g)) else print("[AutoShot] ninguna portería en rango") end
end

-- párate en TU portería y ejecuta esto para que nunca desvíe hacia ella
function api.markOwnGoal()
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local best, bestD
    for _, g in ipairs(goals) do
        local d = (g.center - myRoot.Position).Magnitude
        if not bestD or d < bestD then best, bestD = g, d end
    end
    if best then
        ownGoal = best.center
        print("[AutoShot] portería propia marcada")
    end
end
function api.clearOwnGoal() ownGoal = nil end

function api.status()
    local ball = getBall()
    print("Hook instalado:", hookInstalled, "| Tiros detectados:", shotsSeen)
    print("Shoot:", ShootRemote and ShootRemote:GetFullName() or "NIL")
    print("Pelota:", ball and ball:GetFullName() or "NIL")
    print("Porterías:", #goals, "| Modo:", Config.Mode, "| Activo:", Config.Enabled)
end

if getgenv then getgenv().AutoShot = api end

print("[AutoShot v7] activo — hook:", hookInstalled, "| K o botón = ON/OFF | .status() .diagGoals() .preview()")
