    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroll.Parent = frame

    box = Instance.new("TextBox")
    box.Size = UDim2.new(1, -8, 0, 0)
    box.AutomaticSize = Enum.AutomaticSize.Y
    box.BackgroundTransparency = 1
    box.MultiLine = true
    box.TextWrapped = true
    box.ClearTextOnFocus = false
    box.TextEditable = true
    box.Font = Enum.Font.Code
    box.TextSize = 11
    box.TextColor3 = Color3.fromRGB(225, 230, 240)
    box.TextXAlignment = Enum.TextXAlignment.Left
    box.TextYAlignment = Enum.TextYAlignment.Top
    box.Text = ""
    box.Parent = scroll

    pageLabel = Instance.new("TextLabel")
    pageLabel.BackgroundTransparency = 1
    pageLabel.AnchorPoint = Vector2.new(0, 1)
    pageLabel.Position = UDim2.new(0, 8, 1, -36)
    pageLabel.Size = UDim2.fromOffset(150, 14)
    pageLabel.Font = Enum.Font.Gotham
    pageLabel.TextSize = 10
    pageLabel.TextColor3 = Color3.fromRGB(150, 155, 175)
    pageLabel.TextXAlignment = Enum.TextXAlignment.Left
    pageLabel.Parent = frame

    local function button(text, order, fn)
        local b = Instance.new("TextButton")
        b.AnchorPoint = Vector2.new(0, 1)
        b.Position = UDim2.new((order - 1) / 5, 6, 1, -6)
        b.Size = UDim2.new(0.2, -6, 0, 28)
        b.BackgroundColor3 = Color3.fromRGB(45, 50, 70)
        b.TextColor3 = Color3.new(1, 1, 1)
        b.Font = Enum.Font.GothamBold
        b.TextSize = 12
        b.Text = text
        b.AutoButtonColor = true
        b.Parent = frame
        b.Activated:Connect(fn)
        return b
    end
    button("◀", 1, function() if view == "scan" then pageIdx = math.max(1, pageIdx - 1) render() end end)
    button("▶", 2, function() if view == "scan" then pageIdx = math.min(#pages, pageIdx + 1) render() end end)
    button("Copiar", 3, Scan.copy)
    viewBtn = button("Espía", 4, function() view = view == "scan" and "spy" or "scan" render() end)
    button("X", 5, function() Scan.close() end)

    local parent = LP:FindFirstChild("PlayerGui") or LP:WaitForChild("PlayerGui", 5)
    if not (parent and pcall(function() gui.Parent = parent end)) then
        pcall(function() gui.Parent = gethui and gethui() or svc("CoreGui") end)
    end
end

function Scan.close()
    if closed then return end
    closed = true
    getgenv().BlueScanSpyOn = false
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    if gui then pcall(function() gui:Destroy() end) end
end

--==========================================================================
-- Arranque
--==========================================================================
local okGui, errGui = pcall(buildGui)
if not okGui then
    warn("[BlueScan] no pude crear el panel: " .. tostring(errGui))
end

conns[#conns + 1] = RunService.Heartbeat:Connect(function()
    if spyDirty then
        spyDirty = false
        if view == "spy" then render() end
    end
end)

task.spawn(function()
    local steps = {
        { "Revisando ejecutor...", scanExecutor }, { "Revisando tu personaje...", scanCharacter },
        { "Buscando porterías...", scanGoals }, { "Buscando remotos...", scanRemotes },
        { "Revisando el balón...", scanBall }, { "Leyendo el código del juego...", scanCode },
    }
    for _, st in ipairs(steps) do
        if closed then return end
        setStatus(st[1])
        local ok, err = pcall(st[2])
        if not ok then add("(error en este paso: " .. clip(err, 120) .. ")") end
        render()
        task.wait()
    end
    installSpy()
    setStatus("Listo. Haz UN tiro normal y toca 'Espía'. Luego 'Copiar' o haz captura.")
    render()
end)
